{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open U60 Pro Installer",
  "version": "2.2.1",
  "identifier": "io.github.dklasens.open-u60-pro.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open U60 Pro Installer",
        "width": 940,
        "height": 720,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Install and maintain Open U60 Pro",
    "longDescription": "Guided installer for the Open U60 Pro agent, SSH access and dashboard on the ZTE MU5250.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/platform-tools/": "platform-tools/"
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
